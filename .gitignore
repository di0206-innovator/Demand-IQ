# Data files (keep raw & processed data out of Git, except documentation/.gitkeep)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

# Model artifacts and checkpoints
models/*
!models/.gitkeep
*.joblib
*.pkl
*.onnx

# Reports and generated figures (preserve directory structure)
reports/figures/*
!reports/figures/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example
